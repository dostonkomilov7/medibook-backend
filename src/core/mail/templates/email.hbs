<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if isReset}}Reset your password{{else}}Activate your account{{/if}}</title>
    <style>
        /* Same palette/type as the MediBook app (login/register/dashboards):
           teal for primary actions, coral for warnings, DM Serif Display for
           headings with DM Sans body text — both with plain web-safe
           fallbacks since email clients won't load the web fonts. */
        body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
        body {
            margin: 0;
            padding: 0;
            background-color: #F7F6F2; /* --gray-50 */
            font-family: 'DM Sans', -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
            color: #2C2C2A; /* --gray-800 */
        }
        .email-container {
            max-width: 560px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid #EDEDEA; /* --gray-100 */
            box-shadow: 0 10px 30px rgba(8, 80, 65, 0.08);
        }
        .email-header {
            background: linear-gradient(135deg, #0F6E56 0%, #085041 100%); /* --teal-600 -> --teal-800 */
            color: #ffffff;
            padding: 36px 32px 32px;
            text-align: center;
        }
        .brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            margin-bottom: 14px;
        }
        .email-header h1 {
            margin: 0;
            font-family: 'DM Serif Display', Georgia, 'Times New Roman', serif;
            font-size: 22px;
            font-weight: 400;
            letter-spacing: 0.01em;
        }
        .email-header p {
            margin: 6px 0 0;
            font-size: 13px;
            color: #9FE1CB; /* --teal-100 */
        }
        .email-body {
            padding: 36px 32px;
            line-height: 1.65;
        }
        .email-body h2 {
            font-family: 'DM Serif Display', Georgia, serif;
            font-weight: 400;
            font-size: 20px;
            margin: 0 0 14px;
            color: #2C2C2A;
        }
        .email-body p {
            margin: 0 0 18px 0;
            font-size: 15px;
            color: #5F5E5A; /* --gray-600 */
        }
        /* Activation code */
        .code-box {
            background-color: #F7F6F2;
            border: 1.5px dashed #1D9E75; /* --teal-400 */
            border-radius: 10px;
            text-align: center;
            padding: 22px;
            margin: 8px 0 24px;
        }
        .code-box .code-label {
            margin: 0 0 8px 0;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: #888780; /* --gray-400 */
        }
        .code-value {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 34px;
            font-weight: 400;
            letter-spacing: 8px;
            color: #0F6E56; /* --teal-600 */
            margin: 0;
        }
        /* CTA button (reset password) */
        .cta-wrap { text-align: center; margin: 8px 0 22px; }
        .cta-button {
            display: inline-block;
            background: #0F6E56; /* --teal-600 */
            color: #ffffff !important;
            text-decoration: none;
            padding: 14px 36px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 15px;
        }
        .copy-link {
            background: #F7F6F2;
            border: 1px solid #EDEDEA;
            border-radius: 8px;
            word-break: break-all;
            font-family: 'SF Mono', 'Courier New', monospace;
            font-size: 12px;
            color: #5F5E5A;
            padding: 14px;
            margin: 0 0 20px;
        }
        .expiry-note {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #FAECE7; /* --coral-50 */
            border: 1px solid #F0CFC0;
            border-radius: 8px;
            padding: 12px 16px;
            font-size: 13px;
            color: #A8451F;
            margin: 0 0 22px;
        }
        .security-note {
            font-size: 13px;
            color: #888780;
            border-top: 1px solid #EDEDEA;
            padding-top: 18px;
            margin-top: 4px;
        }
        .email-footer {
            background-color: #F7F6F2;
            padding: 22px 32px;
            text-align: center;
            font-size: 12px;
            color: #888780;
            border-top: 1px solid #EDEDEA;
        }
        .email-footer p { margin: 4px 0; }
        .email-footer a { color: #0F6E56; text-decoration: none; }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <div class="brand-mark">
                <!-- simple cross/pulse mark, matches the brand icon used across the app -->
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L12 7M12 17L12 22M7 12L2 12M22 12L17 12" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            </div>
            <h1>MediBook</h1>
            <p>{{#if isReset}}Password reset request{{else}}Welcome to MediBook{{/if}}</p>
        </div>

        <div class="email-body">
            <h2>Hello {{#if userName}}{{userName}}{{else}}there{{/if}},</h2>

            {{#if isReset}}
            <p>We received a request to reset the password for the MediBook account registered to <strong>{{userEmail}}</strong>. Click the button below to choose a new password.</p>

            <div class="cta-wrap">
                <a href="{{resetUrl}}" class="cta-button">Reset Password</a>
            </div>

            <p style="font-size: 13px; color: #888780; margin-bottom: 8px;">Or copy and paste this link into your browser:</p>
            <div class="copy-link">{{resetUrl}}</div>

            <div class="expiry-note">
                <span>⏱️</span>
                <span>This link expires in {{expirationMinutes}} minutes and can only be used once.</span>
            </div>

            <p class="security-note">If you didn&rsquo;t request a password reset, you can safely ignore this email — your password will remain unchanged.</p>
            {{else}}
            <p>Thanks for signing up! To activate your account and start booking appointments, enter the code below on the verification page.</p>

            <div class="code-box">
                <p class="code-label">Your activation code</p>
                <p class="code-value">{{activationCode}}</p>
            </div>

            <div class="expiry-note">
                <span>⏱️</span>
                <span>This code expires in 10 minutes.</span>
            </div>

            <p class="security-note">If you didn&rsquo;t create a MediBook account, you can safely ignore this email.</p>
            {{/if}}
        </div>

        <div class="email-footer">
            <p>Need help? Contact <a href="mailto:support@medibook.com">support@medibook.com</a></p>
            <p>&copy; {{year}} MediBook &middot; Tashkent</p>
        </div>
    </div>
</body>
</html>
